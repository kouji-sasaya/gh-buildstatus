#!/bin/sh

usage() {
    cat <<'EOF'
Usage:
  gh buildstatus raw2json --input <buildstatus dir> --output <json file>

  gh buildstatus timeseries --input <build dir> --output <dir> [--only cpu,memory,disk,net] [--interval <sec>] [--gzip]

raw2json:   Convert Yocto buildstats raw task records to bar-chart-race JSON.
timeseries: Convert host monitor logs (CPU/memory/disk/net) to per-metric time-series JSON.
EOF
}

if [ "$#" -eq 0 ]; then
    usage
    exit 0
fi

command_name=$1
shift

case "$command_name" in
    raw2json)
        script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
        exec python3 "$script_dir/commands/bar-chart-race.py" "$@"
        ;;
    timeseries)
        script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
        exec python3 "$script_dir/commands/buildstats-timeseries.py" "$@"
        ;;
    -h|--help)
        usage
        ;;
    *)
        printf 'gh-buildstatus: unknown command: %s\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac